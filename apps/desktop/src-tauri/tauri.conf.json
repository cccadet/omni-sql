{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omni-sql",
  "version": "0.1.0",
  "identifier": "dev.omnisql",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm -w --filter @omni-sql/mcp-server build && pnpm dev",
    "beforeBuildCommand": "pnpm -w prepare:resources && pnpm -w validate:resources && pnpm -w --filter desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "omni-sql — One IDE for every database",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' data: blob:; worker-src 'self' blob:; child-src 'self' blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:41920 http://localhost:41920"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3NzA4RjE2RDE3RkQxRkIKUldUNzBYL1JGbzl3TjQ5TmpZVzhiNjBzT3Nvb3NlYy8rTWd6T2NjeVIvOElrWjQ0VEtSZHIyS1EK",
      "endpoints": [
        "https://github.com/cccadet/omni-sql/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
