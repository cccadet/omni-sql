{
  "name": "@omni-sql/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site built from the repository's docs/ folder.",
  "scripts": {
    "sync": "node ./scripts/sync-docs.mjs",
    "dev": "node ./scripts/sync-docs.mjs && astro dev",
    "build": "node ./scripts/sync-docs.mjs && astro build",
    "preview": "astro preview",
    "test": "node --test ./scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.2"
  }
}
