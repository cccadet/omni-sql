{
  "name": "omni-sql",
  "version": "0.0.0",
  "private": true,
  "description": "One IDE for every database.",
  "type": "module",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "test": "pnpm -r --parallel test",
    "verify": "pnpm -r typecheck && pnpm -r lint && pnpm -r test",
    "build": "pnpm -r --filter './packages/**' build",
    "dev:frontend": "pnpm --filter desktop dev",
    "dev:backend": "pnpm --filter backend start",
    "dev:tauri": "pnpm --filter desktop dev:tauri",
    "build:tauri": "pnpm --filter desktop build:tauri",
    "prepare:resources": "node ./scripts/prepare-resources.mjs",
    "validate:resources": "node ./scripts/prepare-resources.mjs --validate",
    "seed:test-connections": "tsx ./docker/test-dbs/register-connections.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "typescript-language-server": "^5.3.0"
  }
}
