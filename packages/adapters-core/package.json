{
  "name": "@omni-sql/adapters-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test ./src/registry.test.ts ./src/cached-adapter.test.ts",
    "coverage": "node --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" --test ./src/registry.test.ts ./src/cached-adapter.test.ts"
  },
  "dependencies": {
    "@omni-sql/ts-types": "workspace:*",
    "@omni-sql/dialect-descriptors": "workspace:*"
  }
}
